#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt { tapping-term-ms = <150>; };

&mt { tapping-term-ms = <150>; };

/ {
    behaviors {
        // Shift no X (mao esquerda): so segura se a proxima tecla for da mao DIREITA

        lsft: left_shift_positional {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };

        // Shift no . (mao direita): so segura se a proxima tecla for da mao ESQUERDA

        rsft: right_shift_positional {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        main {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&trans  &kp Q               &kp W  &kp E          &kp R        &kp T               &kp Y               &kp U         &kp I          &kp O    &kp P                    &trans
&trans  &kp A               &kp S  &kp D          &kp F        &kp G               &kp H               &kp J         &kp K          &kp L    &kp SEMI                 &trans
&trans  &lsft LEFT_SHIFT Z  &kp X  &kp C          &kp V        &kp B               &kp N               &kp M         &kp COMMA      &kp DOT  &rsft RIGHT_SHIFT SLASH  &trans
                                   &mt LCTRL TAB  &lt 1 SPACE  &mt LEFT_WIN ESC    &mt LEFT_ALT ENTER  &lt 2 DELETE  &kp BACKSPACE
            >;
        };

        upper {
            bindings = <
&trans  &kp RA(Q)     &kp NUMBER_7  &kp NUMBER_8   &kp NUMBER_9  &kp MINUS        &kp LS(BACKSLASH)      &kp RIGHT_BRACKET     &kp BACKSLASH          &kp LS(LEFT_BRACKET)  &kp LEFT_BRACKET  &trans
&trans  &kp ASTERISK  &kp NUMBER_4  &kp NUMBER_5   &kp NUMBER_6  &kp PLUS         &kp LS(RIGHT_BRACKET)  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LS(APOSTROPHE)    &kp APOSTROPHE    &trans
&trans  &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3  &mt COMMA DOT    &mkp MB1               &mkp MB2              &mkp MB3               &kp GRAVE             &kp LS(GRAVE)     &trans
                                    &kp BACKSPACE  &trans        &kp ENTER        &trans                 &mo 3                 &trans
            >;
        };

        lower {
            bindings = <
&trans  &kp RA(Q)             &kp RA(W)        &kp PLUS   &kp ASTERISK  &kp LS(NON_US_BSLH)    &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP       &kp END          &none         &trans
&trans  &kp NON_US_BACKSLASH  &kp UNDERSCORE   &kp MINUS  &kp EQUAL     &kp AMPERSAND          &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW      &kp RIGHT_ARROW  &none         &trans
&trans  &kp AT_SIGN           &kp EXCLAMATION  &kp HASH   &kp DOLLAR    &kp PERCENT            &kp C_MUTE      &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT       &kp CAPSLOCK  &trans
                                               &trans     &mo 3         &trans                 &trans          &trans          &trans
            >;
        };

        extra {
            bindings = <
&trans  &kp F15  &kp F7  &kp F8  &kp F9  &kp F12    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F14  &kp F4  &kp F5  &kp F6  &kp F11    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F13  &kp F1  &kp F2  &kp F3  &kp F10    &trans  &trans  &trans  &trans  &trans  &trans
                         &trans  &trans  &trans     &trans  &trans  &trans
            >;
        };
    };
};
